{
  "name": "meshtour-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:apps": "pnpm -r --filter './apps/*' build",
    "sizecheck": "node scripts/check-core-bundle.mjs",
    "assets:manifest": "node scripts/update-italian-flat-manifest.mjs",
    "assets:verify": "node scripts/verify-demo-assets.mjs",
    "packages:verify": "node scripts/verify-package-consumers.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:performance": "playwright test tests/e2e/performance.spec.ts --headed",
    "lint": "pnpm lint:eslint && pnpm lint:format",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:format": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
