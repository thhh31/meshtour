{
  "name": "meshtour-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:apps": "pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.9.3"
  }
}
